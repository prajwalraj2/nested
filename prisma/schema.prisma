// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DomainCategory {
  id          String  @id @default(uuid())
  name        String // "Design & Creative", "Development & Tech"
  slug        String  @unique // "design", "development"
  icon        String? // "🎨", "💻", "🎬"
  description String? // Optional description

  // Flexible 3-column layout
  columnPosition Int @default(1) // 1, 2, or 3 (which column)
  categoryOrder  Int @default(0) // 0, 1, 2, 3... (order within column)

  // Relationships
  domains Domain[]

  // Metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([columnPosition, categoryOrder])
}

/// Where a domain is in its lifecycle.
///
/// Replaces the two-state `isPublished` boolean, which could only say "listed" or "not
/// listed" — there was no way to express "this exists, it is not ready, but tell visitors it
/// is coming."
///
/// An enum rather than a second boolean beside `isPublished`: two booleans give four
/// combinations and "published AND upcoming" is meaningless, so the invalid state would be
/// representable and every read site would have to decide what it meant. Leaves room for
/// ARCHIVED later without another migration to the *shape* of the data.
enum DomainStatus {
  /// Not listed anywhere, and its page 404s. The default for anything new.
  DRAFT

  /// Listed on /domain, in the sidebar and in the sitemap; its page renders.
  PUBLISHED

  /// Listed in the "Upcoming Domains" section at the foot of /domain ONLY — not a link, not
  /// in the sidebar, not in the sitemap, and its page 404s exactly like a DRAFT.
  UPCOMING
}

model Domain {
  id   String @id @default(uuid())
  name String
  slug String @unique

  // Page type: direct content or hierarchical subcategories
  pageType String @default("direct") // "direct" | "hierarchical"

  /// Icon id — a filename (without extension) from `public/icons/`, e.g. "youtube".
  ///
  /// ⚠️ NULL MEANS "USE THE EMOJI ALREADY IN `name`", which is every one of the 41 existing
  /// domains. The emoji is currently a character inside the name string itself
  /// (`"🖌️ Graphic Designing"`), not a separate field — so a row with an icon set AND an emoji
  /// still in its name would render two icons side by side. The emoji must be removed from the
  /// name by hand on the rows that get an icon. See NEW-IMPROVEMENTS.md §27.6 for why this is
  /// done row by row rather than by migrating all 1,216 titles at once.
  ///
  /// ⚠️ Stores the ID, not the URL. The URL is derived (`/icons/<id>.svg`) so that the storage
  /// location stays an implementation detail — if uploads are ever added (J-4) this column can
  /// hold either kind of reference without a migration.
  ///
  /// ⚠️ Validate against `ICON_MANIFEST` before writing. The value reaches an `src` attribute,
  /// and an unrecognised id renders a broken image with no error anywhere — use
  /// `isValidIconId()` from `src/lib/icon-manifest.ts`.
  icon String?

  // Category relationship
  category   DomainCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // Ordering within category
  orderInCategory Int @default(0)

  /// Lifecycle state — the field every read path should use.
  ///
  /// `DRAFT` is the default so a domain created by any path that forgets to set a status is
  /// invisible rather than accidentally live.
  status DomainStatus @default(DRAFT)

  /// ⚠️ SUPERSEDED BY `status`, AND DELIBERATELY KEPT FOR ONE RELEASE.
  ///
  /// Nothing reads this any more. It is still WRITTEN on every create and update
  /// (`isPublished = status === 'PUBLISHED'`) so it cannot drift out of agreement with
  /// `status`.
  ///
  /// Why keep it: atno.io is live, and Neon branches are migrated by hand (there is no
  /// `migrate deploy` in the build — see NEW-IMPROVEMENTS.md §24.4). Leaving the column in
  /// place means rolling the deployment back is a revert, not a data-recovery job against
  /// production. Drop it in its own migration once this release has been running happily.
  isPublished Boolean @default(false)

  // Geo-targeting: Which countries this domain is visible to
  // Values: "ALL" (default, visible everywhere), or country codes like "IN", "US", "GB", "AU", "CA"
  targetCountries String[] @default(["ALL"])

  pages     Page[]
  createdAt DateTime @default(now())

  // Last time this row changed. Prisma sets it automatically on every update.
  // Added so src/app/sitemap.ts can emit an honest <lastmod> — without it the
  // sitemap had to omit lastModified entirely, because using createdAt would
  // claim every page was unchanged since creation. Google ignores lastmod across
  // an entire sitemap once it decides the values are unreliable.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([categoryId, orderInCategory])
}

/// Where a page is in its lifecycle. Mirrors `DomainStatus` one level down.
///
/// ⚠️ A SEPARATE ENUM RATHER THAN REUSING `DomainStatus`, deliberately. Sharing one
/// `ContentStatus` type is conceptually tidier, but renaming a type that is already live on
/// production means sequencing a second type-rename migration against the deploy, plus renaming
/// `lib/domain-status.ts` and its exported constants across every file that imports them.
/// Three duplicated literal values is the cheaper trade — and the *logic* (label maps, status
/// resolution, validation) is still written once and shared.
enum PageStatus {
  /// Not listed anywhere, and the page 404s — along with everything nested beneath it, since
  /// child URLs resolve through their parent.
  DRAFT

  /// Rendered and linked as normal. The default; see the note on the field below.
  PUBLISHED

  /// Named under "Upcoming Resources" at the foot of its section-based parent, and nowhere
  /// else. Not a link, not in the sidebar, not in the sitemap, and the page itself 404s.
  UPCOMING
}

model Page {
  id    String @id @default(uuid())
  title String
  slug  String

  /// Which layout component renders this page.
  ///
  ///   "narrative" | "section_based" | "subcategory_list" | "table" | "rich_text"
  ///   | "mixed_content" | "roadmap"
  ///
  /// ⚠️ A PLAIN `String`, NOT AN ENUM — so the database validates nothing here, and adding a
  /// value is a comment change rather than a migration. The cost is that the permitted set is
  /// duplicated across **nine** places in `src/`, none of which fail to compile when one is
  /// missed. Adding a content type means updating every one of them:
  ///
  ///   PageForm.tsx            CONTENT_TYPE_OPTIONS      the creation dropdown
  ///   PageTree.tsx            CONTENT_TYPE_ICONS        icon in the admin tree
  ///   PageTree.tsx            formatContentType         its human-readable label
  ///   SectionEditor.tsx       PageTypeIcon              icon in the section editor
  ///   api/admin/pages         validContentTypes         POST validation
  ///   api/admin/pages/[id]    validContentTypes         PUT validation
  ///   domain/[...slug]        buildPageDescription      the meta description template
  ///   domain/[...slug]        switch (page.contentType) which layout renders
  ///   sitemap.ts              select + pageLastModified ⚠️ only if it has its own table
  ///
  /// ⚠️ Miss one and it fails SILENTLY and DIFFERENTLY each time: a missing validator entry
  /// rejects the value at runtime with no type error; a missing icon falls back; a missing
  /// switch case renders the narrative layout. This is the seventh occurrence of the
  /// rebuild-by-explicit-field-list bug recorded in NEW-IMPROVEMENTS.md — the pattern is that
  /// **a list cannot complain about a value it was never told about.**
  contentType String @default("narrative")

  /// Icon id from `public/icons/` — the same field as `Domain.icon`, see the long note there.
  ///
  /// ⚠️ 1,200 of the 1,216 existing pages carry their emoji inside `title`, so the same
  /// two-icons caveat applies: remove the emoji from the title of any page you give an icon to.
  ///
  /// ⚠️ One icon serves many pages. The data shows 395 distinct titles across 1,216 pages —
  /// a 3.1× reuse factor — so "YouTube Channels" under a dozen domains all reference the single
  /// `youtube` icon. That is why this is an id rather than an uploaded file per row.
  icon String?

  /// Lifecycle state — the field every read path should filter on.
  ///
  /// ⚠️ DEFAULTS TO `PUBLISHED`, THE OPPOSITE OF `Domain.status`, AND THAT IS DELIBERATE.
  ///
  /// A domain defaults to DRAFT because creating one is always a conscious admin action, so
  /// "invisible until I say so" is the safe direction. Pages are different: of the five
  /// `prisma.page.create` call sites, TWO are side effects of *domain* operations — creating a
  /// direct domain creates its `__main__` page, and changing a domain's `pageType` recreates
  /// it. Nobody is choosing to create a page there.
  ///
  /// With a DRAFT default, either of those paths would produce an invisible `__main__` and the
  /// entire domain root would 404 — the failure `[#11]` already warns about in
  /// `domain/[...slug]/page.tsx`, except silent and self-inflicted.
  ///
  /// The default also makes the migration a bare `ADD COLUMN`: it gives all 1,205 existing rows
  /// the correct value, so no backfill is required. Contrast `Domain`, where the default was
  /// wrong for existing data and a hand-written `CASE` backfill was the difference between
  /// working and blanking the homepage.
  ///
  /// ⚠️ A `__main__` page must never leave PUBLISHED — the API refuses it. See
  /// `api/admin/pages/[id]/route.ts`.
  status PageStatus @default(PUBLISHED)

  // Section configuration for section_based pages
  // Stores how child pages are organized into 3-column layout
  sections Json?

  domain   Domain @relation(fields: [domainId], references: [id])
  domainId String

  parent   Page?          @relation("PageToSubPages", fields: [parentId], references: [id])
  parentId String?
  subPages Page[]         @relation("PageToSubPages")
  content  ContentBlock[]

  // Table relationship - one page can have one table
  table Table?

  // Rich text relationship - one page can have one rich text content
  richTextContent RichTextContent?

  /// Roadmap relationship — one page can have one roadmap (#33 / Phase L).
  ///
  /// ⚠️ THE THIRD CONTENT TABLE. `sitemap.ts` reads every content relation to compute an
  /// honest `<lastmod>`; adding this one without adding it there makes roadmap pages report a
  /// stale date. That file carries a warning saying exactly this — heed it.
  roadmap Roadmap?

  // Geo-targeting: Which countries this page is visible to
  // Values: "ALL" (default, visible everywhere), or country codes like "IN", "US", "GB", "AU", "CA"
  targetCountries String[] @default(["ALL"])

  order     Int      @default(0)
  createdAt DateTime @default(now())

  // See the note on Domain.updatedAt — same purpose, same reasoning.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([domainId, parentId, slug])
}

model ContentBlock {
  id     String @id @default(uuid())
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String

  type           ContentBlockType
  content        Json
  order          Int              @default(0)
  columnPosition Int              @default(1)
  isActive       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum ContentBlockType {
  HEADING
  PARAGRAPH
  BULLETLIST
  TABLE
  COLLAPSIBLE
  COLUMN
  TEXT
  LINK_BUTTON
  NAVIGATION
  SECTION_DIVIDER
  IMAGE
  VIDEO
  QUOTE

  // New section-based content types
  SECTION_HEADER // For section titles like "Skill Development"
  SECTION_LINKS // For lists of links within sections
  SUBCATEGORY_CARD // For subcategory selection cards

  // Table-related content types
  TABLE_CONTAINER // For pages that contain tables
  TABLE_DESCRIPTION // For table descriptions/headers

  // Rich text related content types
  RICH_TEXT_CONTAINER // For pages that contain rich text
  RICH_TEXT_SECTION // For rich text sections
  RICH_TEXT_EDITOR // For embedded rich text editors
}

model Table {
  id     String @id @default(uuid())
  name   String // Table name/title
  pageId String @unique
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Table Schema Definition (JSON)
  // Structure: { columns: [{ id, name, type, sortable, filterable, width, ... }] }
  schema Json

  // Table Data (JSON) 
  // Structure: { rows: [{ id, [columnId]: content, ... }] }
  data Json

  // Table Settings (JSON)
  // Structure: { pagination, sorting, filtering, responsive, ... }
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

model RichTextContent {
  id     String @id @default(uuid())
  pageId String @unique // One-to-one with Page
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Main HTML content storage
  htmlContent String @db.Text // Raw HTML content

  // Metadata
  title     String? // Optional title for the content
  wordCount Int     @default(0)

  // Auto-generated content for search and SEO
  plainText String? @db.Text // For search functionality

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

/// One roadmap — a step-by-step learning path on a page (#33 / Phase L).
///
/// Sits on a Page exactly the way `Table` and `RichTextContent` do: one row per page,
/// `pageId @unique`, cascade-deleted with it.
///
/// ⚠️ THIS MODEL IS NOT A "CATEGORY" OR A "ROLE". Frontend / Backend / Full-stack are three
/// separate PAGES, each owning its own Roadmap row — see 33.2(a). That is what gives every role
/// a URL, an order, an icon, a status, geo-targeting, a sitemap entry and a sidebar entry
/// **without any of it being written**, because `Page` already has all of those columns.
///
/// The consequence worth knowing: the "Choose your role" dropdown is DERIVED, not configured —
/// it is the answer to "which of my sibling pages have contentType = 'roadmap'?". There is
/// nothing to keep in sync, and a role cannot appear in the dropdown but 404 on click, because
/// the same row decides both.
model Roadmap {
  id     String @id @default(uuid())
  pageId String @unique
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// Heading above the tree, e.g. "Frontend Developer".
  ///
  /// Separate from `page.title` for the same reason `Table.name` is: the page is "Frontend" in
  /// the sidebar and the breadcrumb, where short wins, but the heading on the page itself often
  /// wants to be longer.
  title String

  /// One-line intro under the title.
  ///
  /// ⚠️ PLAIN TEXT, NOT HTML — it also feeds the meta description, and markup there would be
  /// rendered as literal characters in search results.
  description String?

  /// { defaultExpanded: boolean, showProgress: boolean, ... }
  ///
  /// JSON for the same reason `Table.settings` is: display preferences that will grow, each of
  /// which would otherwise be a migration.
  ///
  /// ⚠️ READ IT THROUGH A RESOLVER USING `??`, NEVER `||`. `defaultExpanded: false` read with
  /// `||` silently becomes `true` — that is finding #28 exactly, which detached 74 pages by
  /// making a row its own parent.
  settings Json?

  nodes RoadmapNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One topic in a roadmap. Self-referencing, so nesting is unlimited.
model RoadmapNode {
  id String @id @default(uuid())

  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  /// Self-relation — the same shape as `Page.parentId` / `Page.subPages`, already proven in
  /// this codebase. NULL = a top-level step ("Step 1: Programming / Scripting").
  ///
  /// ⚠️ `onDelete: Cascade` ON THE SELF-RELATION TOO, so deleting a step takes its sub-topics
  /// with it. Without it, deleting a parent leaves orphans that belong to the roadmap but to no
  /// visible parent — rows that render nowhere and can only be found by SQL.
  parentId String?
  parent   RoadmapNode?  @relation("NodeToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children RoadmapNode[] @relation("NodeToChildren")

  title String

  /// Deep-link fragment: /domain/webdev/roadmap/frontend?topic=kubernetes
  ///
  /// ⚠️ Unique WITHIN one roadmap, not globally — see `@@unique` below. "docker" exists as an
  /// independent row in both the Frontend and Backend roadmaps. That duplication is deliberate
  /// (33.2): a shared node would make ordering ambiguous, since the same topic would need two
  /// different positions. Scoping the constraint is what permits it.
  slug String

  /// Icon id from `public/icons/` — the SAME field and manifest as `Page.icon` and
  /// `Domain.icon`.
  ///
  /// ⚠️ Validate with `isValidIconId()` before writing. The value reaches an `src` attribute,
  /// and an unrecognised id renders a broken image with no error anywhere.
  icon String?

  order Int @default(0)

  /// Where this node's children are drawn — and therefore where its expand circle sits (L-13).
  ///
  ///   "bottom"  children stack underneath;  circle at the bottom edge, centred
  ///   "right"   children extend rightward;  circle on the right edge, centred
  ///
  /// ⚠️ ONE FIELD FOR BOTH, because they are one decision. A right-branching node with a
  /// bottom circle would point at empty space — the control has to sit where the children
  /// actually come out, or it stops being a control and becomes decoration.
  ///
  /// ⚠️ "right" COSTS HORIZONTAL SPACE ON TOP OF THE NORMAL INDENT. Below the `sm` breakpoint
  /// the renderer forces every node back to "bottom" — see RoadmapBranching. Without that a
  /// three-level roadmap runs off a 390px screen and the page body scrolls sideways, which is
  /// the failure K-3 fought in tables.
  branchFrom String @default("bottom")

  /// How this node's children attach to it (L-13).
  ///
  ///   "branch"  one horizontal arm per child — "learn all of these"
  ///             ├──── OSI Model
  ///             ├──── Network Protocol
  ///             └──── Subnets / CIDR
  ///
  ///   "group"   children sit flush against a shared rail — "pick one of these"
  ///             └──┐
  ///                │[ AWS ] [ Azure ] [ GCP ]
  ///
  /// ⚠️ SEPARATE FROM `branchFrom`. Both connector styles work in both directions, and the
  /// source design uses three of the four combinations. Folding them into one field was my
  /// first reading and it was wrong.
  ///
  /// The distinction is visual, but it tracks a real one: the author reached for "group"
  /// exactly where the children are ALTERNATIVES (AWS/Azure/GCP, EKS/GKE/AKS) and "branch"
  /// where they are a sequence. That is the same thing roadmap.sh uses dotted lines to say, so
  /// the default is predictable: "branch" unless the children are a choose-one set.
  connector String @default("branch")

  /// The "Recommended" flag — AWS, Docker, Kubernetes, EKS in the source sketch.
  ///
  /// ⚠️ NO LONGER RENDERED (L-13). Free-text `badges` replaced it on screen, because an author
  /// wants "Start with this" or "Very Important" as readily as "Recommended". The column and its
  /// editor control are kept deliberately — the data is real and costs nothing — but **nothing
  /// on the public page reads it**. Do not add styling that depends on it without deciding what
  /// it means alongside a badge that says the same thing.
  ///
  /// ⚠️ A BOOLEAN, NOT JUST ANOTHER ENTRY IN `badges`, because it changes how the NODE is drawn
  /// (a filled marker on the spine), not merely what pill sits beside it. As a string it would
  /// have to be styled by matching the literal text "Recommended", which breaks the first time
  /// somebody types "recommended" or "Recommended ⭐".
  recommended Boolean @default(false)

  /// Free-text labels: "Free", "Paid", "Beginner".
  ///
  /// Coloured by `assignBadgeColors` (K-1) over the distinct set within ONE roadmap, so a given
  /// word is the same colour all the way down the page. ⚠️ That function sorts with plain `<`
  /// and not `localeCompare` — the two disagree between server and client and produce a React
  /// hydration mismatch.
  ///
  /// Free text rather than a fixed list (user's call), so adding a label is never a code change.
  badges String[] @default([])

  /// The Sheet body. HTML, authored in the admin.
  ///
  /// ⚠️ NOT SANITISED. Sanitisation was removed site-wide (#35), so this is stored verbatim and
  /// rendered with `dangerouslySetInnerHTML`. `ROADMAP-CONTENT-GUIDE.md` (L-12) is the control.
  ///
  /// ⚠️ NULL OR EMPTY MEANS THE TOPIC HAS NO SHEET — it is a label on the spine, not a link.
  /// Several nodes in the source sketch are exactly that (OSI Model, GCP, AKS), and the renderer
  /// must not make them look clickable.
  htmlContent String? @db.Text

  /// Stripped text, for search and the meta description. Written by the API alongside the HTML
  /// in the same handler, so the two cannot disagree — the same arrangement as
  /// `RichTextContent.plainText`. Use `htmlToPlainText` from `src/lib/html-text.ts`.
  plainText String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One "kubernetes" per roadmap, so `?topic=` is never ambiguous.
  @@unique([roadmapId, slug])
  /// The tree read: every node of one roadmap, in order.
  @@index([roadmapId, parentId, order])
}

// Authentication Models for Auth.js
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String // Hashed password
  isAdmin     Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // --- Brute-force protection (see src/lib/auth.ts) ---------------------------
  //
  // WHY THESE LIVE IN THE DATABASE rather than in memory: Vercel runs this app as
  // serverless functions, and each instance has its own separate memory. A counter
  // held in a JS `Map` would be reset by every cold start and would not be shared
  // between two instances, so an attacker spreading guesses across concurrent
  // connections would never trip it. Postgres is the one piece of state every
  // instance already shares, which makes it the correct place to count.
  //
  // WHY PER-ACCOUNT rather than per-IP: an attacker can rotate IP addresses cheaply
  // (proxies, mobile networks), which defeats IP-based limits. Locking the *account*
  // does not care where the guesses come from.

  /**
   * Consecutive failed sign-in attempts. Reset to 0 on any successful sign-in, and
   * also reset once an existing lock expires so each lock starts a fresh window.
   */
  failedLoginAttempts Int @default(0)

  /**
   * When set to a FUTURE timestamp, sign-in is refused without even checking the
   * password. `null` (or a past timestamp) means not locked.
   * Storing an expiry instant rather than a "locked" boolean means the lock releases
   * itself — no scheduled job is needed to unlock accounts.
   */
  lockedUntil DateTime?

  // Track who created this user (for admin audit)
  createdBy     String?
  createdByUser User?   @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers  User[]  @relation("UserCreatedBy")

  // Auth.js required relations
  accounts Account[]
  sessions Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// An image referenced by table rows (K-5a, #29.6d).
///
/// ⚠️ ROWS STORE `key`, NEVER `url`. That indirection is the whole design:
///
///   • **Reuse.** 7,602 rows resolve to 4,521 distinct things (1.68x). One `pixabay` image
///     serves 40 rows across several tables. Stored as a URL per row that is 40 copies to
///     update; stored as a key it is one write.
///   • **Replacement.** New artwork under the same key changes every referencing row at
///     once, with no hunting and no cache problem — see `url` below.
///   • **Portability.** Moving from Vercel Blob to Cloudflare R2 rewrites this one column
///     rather than thousands of rows inside 654 JSON blobs. Full procedure in
///     `BLOB-TO-R2-MIGRATION.md`.
model TableImage {
  id String @id @default(uuid())

  /// What rows reference — human-chosen and stable, e.g. "pixabay". Changing the artwork
  /// does not change this.
  key String @unique

  /// The object URL. ⚠️ **Content-hashed**, so different bytes always produce a different
  /// URL. That makes `immutable, max-age=31536000` safe and removes the "never overwrite,
  /// use -v2" discipline that `ICON-GUIDE.md` §9 needs for repository-hosted icons.
  url String

  /// Which service holds the object. ⚠️ Present from day one so a PARTIALLY migrated bucket
  /// is representable — without it the move to R2 would be all-or-nothing with a broken
  /// window in between, since objects cannot be copied instantaneously.
  provider String @default("vercel-blob")

  /// Dimensions and size after the server re-encodes. Stored so the admin's Image
  /// Management screen (K-5b) can show them without fetching every object.
  width  Int
  height Int
  bytes  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ordered newest-first in the admin; indexed because that listing is the common read.
  @@index([createdAt])
}

/// Per-source request counters for public forms (M-4).
///
/// ⚠️ IN POSTGRES, NOT IN MEMORY. Each serverless instance has its own memory, so a JS `Map`
/// resets on every cold start and is not shared between concurrent instances — an attacker
/// spreading requests across connections would never trip it. Identical reasoning to
/// `User.failedLoginAttempts`, and the same conclusion: Postgres is the one piece of state
/// every instance shares.
model RateLimit {
  /// ⚠️ An HMAC of the action plus the source, NOT a plain hash and NEVER the raw IP.
  ///
  /// The plan originally said `sha256("feedback:" + ip)`. That is not anonymisation: there are
  /// only ~4 billion IPv4 addresses, so the entire hash space can be enumerated on a laptop and
  /// reversed. Keying the digest with a secret (see `sourceKey` in `lib/public-forms.ts`) is
  /// what makes it a pseudonym rather than a reversible encoding of personal data.
  key String @id

  /// ⚠️ A FIXED WINDOW, NOT A SLIDING ONE — the plan says "sliding", but two columns cannot
  /// express that. A true sliding window needs a timestamp per request, which costs a row per
  /// request forever. The cost of the simpler model is boundary burst: 10 requests at 09:59 and
  /// 10 more at 10:01 pass a "10 per 10 minutes" limit. Acceptable for spam control, and written
  /// down here so nobody later reads "sliding" in the plan and assumes this delivers it.
  count       Int
  windowStart DateTime

  /// Supports the opportunistic prune of expired rows. Without it the table grows forever, since
  /// nothing else ever deletes from it.
  @@index([windowStart])
}

/// A bug report or suggestion from a visitor (M-5).
///
/// ⚠️ EVERY FIELD HERE IS ATTACKER-CONTROLLED. This is the first model on the site whose rows are
/// written by strangers rather than by the single trusted admin that #35 assumed. It must render
/// as TEXT in the admin, never as HTML — see NEW-IMPROVEMENTS-3.md §36.4 rule 1, and the lint rule
/// in `eslint.config.mjs` that enforces it.
model Feedback {
  id String @id @default(uuid())

  /// "ui-bug" | "feature-request" | "content-issue" | "other"
  category String
  message  String @db.Text

  /// ⚠️ Optional. Requiring an email to report a broken button loses most bug reports.
  email String?
  name  String?

  /// ⚠️ CAPTURED AUTOMATICALLY, NOT TYPED. A UI bug report without knowing which page it was on
  /// is close to useless, and nobody types their own URL accurately.
  pageUrl String?

  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Someone proposing a tool, or requesting a new domain (M-6).
///
/// ⚠️ ATTACKER-CONTROLLED, like `Feedback`. It renders as TEXT in the admin, never as HTML —
/// see NEW-IMPROVEMENTS-3.md §36.4 rule 1 and the lint rule in `eslint.config.mjs`.
model Submission {
  id String @id @default(uuid())

  /// "tool" | "domain-request"
  kind String

  /*
    Where the submitter thinks it belongs. All four optional — the form explicitly offers
    "not sure" as a real answer, and a domain REQUEST has no existing domain by definition.

    ⚠️ PLAIN STRINGS, NOT FOREIGN KEYS, AND THE NAME IS STORED ALONGSIDE THE ID.

    A submission is a HISTORICAL RECORD. With an FK, deleting a domain would either cascade the
    submission away or block the delete — both wrong. And an id alone becomes meaningless the day
    its row disappears, so the label is snapshotted at submission time and the record stays
    readable forever.

    ⚠️ `pageId` / `pageName` ARE DELIBERATELY UNWRITTEN FOR NOW. The agreed plan had a
    domain → page cascade; the scope was cut to the domain alone on 19 Aug 2026. The columns are
    kept because they are nullable and free, and because adding the page step later then needs no
    migration. If you are wondering why they are always NULL — that is why, not a bug.
  */
  domainId   String?
  domainName String?
  pageId     String?
  pageName   String?

  productName String

  /// ⚠️ OPTIONAL, WHICH DEVIATES FROM THE PLAN'S SCHEMA — agreed 19 Aug 2026. A domain REQUEST
  /// ("please add Photography") has no product URL, so requiring one would mean either a blocked
  /// submission or a fabricated value. Validation makes it conditional instead: required when
  /// `kind` is "tool", optional otherwise. See the discriminated union in `api/submit/route.ts`.
  ///
  /// ⚠️ WHATEVER IS STORED HERE IS ONLY EVER `http:` OR `https:` — the POST route rejects every
  /// other scheme. That is what makes it safe for the admin to render as a link at all; a stored
  /// `javascript:` URL would be one click from running in a logged-in admin session.
  productUrl  String?
  description String  @db.Text

  /// ⚠️ REQUIRED here, unlike `Feedback` where both are optional. You cannot act on a tool
  /// suggestion without being able to ask a follow-up question.
  submitterName  String
  submitterEmail String

  /// "new" | "reviewed" | "accepted" | "rejected"
  status    String  @default("new")
  adminNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
